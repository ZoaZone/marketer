{
  "name": "Referral",
  "type": "object",
  "properties": {
    "affiliate_id": {
      "type": "string"
    },
    "cookie_id": {
      "type": "string",
      "description": "Persistent anonymous id generated client-side on first touch (stored in localStorage \u2014 this is a browser SPA, not a server-rendered site)."
    },
    "referred_user_id": {
      "type": "string",
      "description": "Purchasing user's email \u2014 set at conversion time, empty until then."
    },
    "landing_code": {
      "type": "string",
      "description": "The ?ref= code the visitor landed with."
    },
    "first_touch_at": {
      "type": "string",
      "format": "date-time"
    },
    "converted": {
      "type": "boolean",
      "default": false
    },
    "attribution_window_days": {
      "type": "number",
      "default": 30
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "affiliate_id",
    "cookie_id",
    "landing_code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}