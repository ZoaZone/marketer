{
  "name": "SocialAccount",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "description": "Link to Brand"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "facebook",
        "tiktok",
        "linkedin",
        "youtube",
        "twitter_x",
        "pinterest",
        "whatsapp",
        "email"
      ]
    },
    "account_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "access_token": {
      "type": "string",
      "description": "DEPRECATED legacy plaintext token, read-only. Never write this again \u2014 saveSocialAccount writes access_token_enc. Consumers (publishScheduledPosts, testSocialConnection) read it only as a fallback for records created before encryption existed, and it is blanked when such a record is next saved."
    },
    "refresh_token": {
      "type": "string",
      "description": "DEPRECATED legacy plaintext token, read-only. See access_token."
    },
    "access_token_enc": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the platform access token, stored as JSON {ciphertext, iv} and encrypted with BYOK_ENCRYPTION_KEY \u2014 the same scheme saveApiKey uses for BYOK provider keys. Written ONLY by the saveSocialAccount backend function; never set from the client and never returned to it."
    },
    "refresh_token_enc": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the refresh token as JSON {ciphertext, iv}. See access_token_enc."
    },
    "token_hint": {
      "type": "string",
      "description": "Last 4 characters of the access token, so the UI can show which credential is stored without ever handling the secret."
    },
    "token_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the stored credential was last written \u2014 lets the UI flag stale tokens for platforms that expire them."
    },
    "page_id": {
      "type": "string"
    },
    "connection_method": {
      "type": "string",
      "enum": [
        "credentials",
        "api",
        "webhook"
      ],
      "default": "api",
      "description": "\"credentials\" (raw username/password) is kept only for reading pre-existing records \u2014 none of these platforms' posting APIs accept it, so it's no longer offered when creating a new account."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "connected",
        "disconnected",
        "expired"
      ],
      "default": "active"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "platform",
    "account_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}