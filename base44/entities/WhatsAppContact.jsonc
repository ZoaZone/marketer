{
  "name": "WhatsAppContact",
  "type": "object",
  "properties": {
    "wa_id": {
      "type": "string",
      "description": "Meta's WhatsApp ID for the person \u2014 digits only, no '+' (e.g. 12566998899). Unique per contact."
    },
    "phone_e164": {
      "type": "string",
      "description": "Same number normalised to E.164 for display and CRM matching (e.g. +12566998899)."
    },
    "profile_name": {
      "type": "string",
      "description": "Name from the WhatsApp profile, as sent by Meta in contacts[].profile.name."
    },
    "display_name": {
      "type": "string",
      "description": "Name a human agent typed for this contact. Overrides profile_name in the UI."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "opted_out": {
      "type": "boolean",
      "default": false,
      "description": "Set when the contact asks to stop. Outbound sends are refused while true."
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wa_id"
  ],
  "permissions": {
    "read": "true",
    "create": "user.role == 'admin'",
    "update": "user.role == 'admin'",
    "delete": "user.role == 'admin'"
  },
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
