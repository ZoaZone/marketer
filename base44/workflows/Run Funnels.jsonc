{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "run_funnels",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_due_leads": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runFunnels",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send due funnel messages",
            "description": "Email and WhatsApp"
          }
        }
      }
    ]
  },
  "name": "Run Funnels",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Calcutta",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 15 minutes, sends the email or WhatsApp message for each lead whose funnel stage is due."
}